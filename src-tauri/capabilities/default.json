{
  "$schema": "https://schema.tauri.app/config/2/capabilities",
  "description": "Capabilities for the Zen desktop app (Windows/macOS/Linux).",
  "identifier": "default",
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "updater:default",
    "notification:default",
    "process:default"
  ],
  "windows": [
    "main"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ]
}
